{
  "name": "codesight-dynamic-visualizer",
  "displayName": "CodeSight Dynamic Visualizer",
  "description": "Non-invasive runtime visualizer using the Debug Adapter Protocol (DAP) to render stack, heap, and data structures in real-time.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:codesight.start",
    "onDebug"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prettier": "echo 'format step skipped'"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "typescript": "^4.0.0",
    "vscode-test": "^1.6.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "codesight.start",
        "title": "CodeSight: Open Dynamic Visualizer"
      }
    ]
  }
}